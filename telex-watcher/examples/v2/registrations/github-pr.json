{
  "schemaVersion": 2,
  "id": "example-github-pr",
  "command": ["pwsh", "-NoLogo", "-NoProfile", "-File", "C:\\watchers\\github-pr.ps1"],
  "intervalSeconds": 300,
  "timeoutSeconds": 30,
  "backendProfile": "YOUR-PROFILE",
  "sender": "service:watcher/examples",
  "target": "project:example/inbox",
  "environmentAllowlist": ["GH_TOKEN", "GH_CONFIG_DIR"],
  "parameters": { "repository": "OWNER/REPO", "pullRequestNumber": 123 }
}
