{
  "id": "example-azure-devops-pr",
  "detectorSchemaVersion": 1,
  "command": [
    "pwsh",
    "-NoLogo",
    "-NoProfile",
    "-File",
    "<DETECTOR-PATH>"
  ],
  "scriptPath": "<DETECTOR-PATH>",
  "workingDirectory": "<TEMPLATE-DIRECTORY>",
  "scriptMode": "pinned",
  "scriptDigest": "d356bea898e370d60cdcf01210a0d4205ab07f52ebd09d1fe9851406755c4f6f",
  "backendProfile": "default",
  "sender": "watcher@example.invalid",
  "target": "recipient@example.invalid",
  "attention": "next-checkpoint",
  "requiresDisposition": false,
  "intervalSeconds": 300,
  "timeoutSeconds": 30,
  "allowedEventKinds": [
    "azure-devops.pull-request.attention",
    "azure-devops.pull-request.completed",
    "azure-devops.pull-request.ready-to-merge"
  ],
  "allowedEventKindPrefixes": [],
  "environmentAllowlist": [
    "AZURE_DEVOPS_ACCESS_TOKEN"
  ],
  "parameters": {
    "organization": "AZURE-DEVOPS-ORGANIZATION",
    "project": "AZURE-DEVOPS-PROJECT",
    "repositoryId": "AZURE-DEVOPS-REPOSITORY-ID",
    "pullRequestId": 123,
    "allowBearerAuthentication": true,
    "allowPatAuthentication": false,
    "blockingReviewerVoteAtMost": -10,
    "emitInitialCreatedEvent": false,
    "emitInitialSnapshot": false
  },
  "initialState": {},
  "maxSafeDowntimeSeconds": 1800
}
