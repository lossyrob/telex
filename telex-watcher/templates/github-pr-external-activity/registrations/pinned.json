{
  "id": "example-github-pr-external-activity",
  "detectorSchemaVersion": 1,
  "command": [
    "pwsh",
    "-NoLogo",
    "-NoProfile",
    "-File",
    "<DETECTOR-PATH>"
  ],
  "scriptPath": "<DETECTOR-PATH>",
  "workingDirectory": "<TEMPLATE-DIRECTORY>",
  "scriptMode": "pinned",
  "scriptDigest": "e09936ecb78e68e441dd747c229d0f7a58e850e6651f3d9089d46fc0f1d0cadd",
  "backendProfile": "default",
  "sender": "watcher@example.invalid",
  "target": "recipient@example.invalid",
  "attention": "next-checkpoint",
  "requiresDisposition": false,
  "intervalSeconds": 300,
  "timeoutSeconds": 30,
  "allowedEventKinds": [
    "github.pull-request.external-activity"
  ],
  "allowedEventKindPrefixes": [],
  "environmentAllowlist": [
    "GH_TOKEN"
  ],
  "parameters": {
    "repository": "OWNER/REPOSITORY",
    "pullRequestNumber": 123,
    "selfLogin": "YOUR-GITHUB-LOGIN",
    "ignoredLogins": [
      "example-bot"
    ]
  },
  "initialState": {},
  "maxSafeDowntimeSeconds": 3600
}
