{
  "id": "example-github-pr",
  "detectorSchemaVersion": 1,
  "command": [
    "pwsh",
    "-NoLogo",
    "-NoProfile",
    "-File",
    "<DETECTOR-PATH>"
  ],
  "scriptPath": "<DETECTOR-PATH>",
  "workingDirectory": "<TEMPLATE-DIRECTORY>",
  "scriptMode": "pinned",
  "scriptDigest": "e9358b39bc6498faaae806c54d5d5245b768f1ccdfbd442c8f6f10e45b818c89",
  "backendProfile": "default",
  "sender": "watcher@example.invalid",
  "target": "recipient@example.invalid",
  "attention": "next-checkpoint",
  "requiresDisposition": false,
  "intervalSeconds": 300,
  "timeoutSeconds": 30,
  "allowedEventKinds": [
    "github.pull-request.attention",
    "github.pull-request.completed",
    "github.pull-request.ready-to-merge"
  ],
  "allowedEventKindPrefixes": [],
  "environmentAllowlist": [
    "GH_TOKEN"
  ],
  "parameters": {
    "repository": "OWNER/REPOSITORY",
    "pullRequestNumber": 123,
    "emitInitialSnapshot": false
  },
  "initialState": {},
  "maxSafeDowntimeSeconds": 900
}
