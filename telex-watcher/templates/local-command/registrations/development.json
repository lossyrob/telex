{
  "id": "example-local-command-development",
  "detectorSchemaVersion": 1,
  "command": [
    "pwsh",
    "-NoLogo",
    "-NoProfile",
    "-File",
    "C:\\path\\to\\telex-watcher\\templates\\local-command\\detector.ps1"
  ],
  "scriptPath": "C:\\path\\to\\telex-watcher\\templates\\local-command\\detector.ps1",
  "workingDirectory": "C:\\path\\to\\telex-watcher\\templates\\local-command",
  "scriptMode": "follow-path",
  "backendProfile": "default",
  "sender": "watcher@example.invalid",
  "target": "recipient@example.invalid",
  "attention": "fyi",
  "requiresDisposition": false,
  "intervalSeconds": 60,
  "timeoutSeconds": 30,
  "allowedEventKinds": [
    "local.command.condition-met"
  ],
  "allowedEventKindPrefixes": [],
  "environmentAllowlist": [],
  "parameters": {
    "command": [
      "C:\\path\\to\\observational-check.exe",
      "--json"
    ],
    "workingDirectory": "C:\\path\\to",
    "sourceId": "example-local-command",
    "conditionExitCodes": [
      0
    ],
    "successExitCodes": [
      1
    ],
    "commandTimeoutSeconds": 20,
    "maxOutputChars": 16384,
    "emitInitialSnapshot": true
  },
  "initialState": {},
  "maxSafeDowntimeSeconds": 300
}
