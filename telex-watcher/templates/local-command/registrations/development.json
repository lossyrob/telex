{
  "id": "example-local-command-development",
  "detectorSchemaVersion": 1,
  "command": [
    "pwsh",
    "-NoLogo",
    "-NoProfile",
    "-File",
    "<DETECTOR-PATH>"
  ],
  "scriptPath": "<DETECTOR-PATH>",
  "workingDirectory": "<TEMPLATE-DIRECTORY>",
  "scriptMode": "follow-path",
  "backendProfile": "default",
  "sender": "watcher@example.invalid",
  "target": "recipient@example.invalid",
  "attention": "fyi",
  "requiresDisposition": false,
  "intervalSeconds": 60,
  "timeoutSeconds": 30,
  "allowedEventKinds": [
    "local.command.condition-met"
  ],
  "allowedEventKindPrefixes": [],
  "environmentAllowlist": [],
  "parameters": {
    "command": [
      "<OBSERVATIONAL-COMMAND>",
      "--json"
    ],
    "workingDirectory": "<COMMAND-WORKING-DIRECTORY>",
    "sourceId": "example-local-command",
    "conditionExitCodes": [
      0
    ],
    "successExitCodes": [
      1
    ],
    "commandTimeoutSeconds": 20,
    "maxOutputChars": 16384
  },
  "initialState": {},
  "maxSafeDowntimeSeconds": 300
}
