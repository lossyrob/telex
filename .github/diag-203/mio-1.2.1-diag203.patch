+
+/// Issue #203 diagnostic only: records the Mio 1.2.1 state in which an already
+/// submitted overlapped operation is reported as `Err`, so its scheduler drops
+/// the reserved `Arc<Inner>` reference while the queued completion packet will
+/// consume it again (tokio-rs/mio#2014). Behaviour is otherwise unchanged.
+pub(crate) fn diag203_hit(kind: &str, detail: String) {
+    use std::io::Write;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static SEQ: AtomicU64 = AtomicU64::new(0);
+    let seq = SEQ.fetch_add(1, Ordering::SeqCst) + 1;
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0);
+    let thread = std::thread::current();
+    let exe = std::env::current_exe()
+        .map(|p| p.display().to_string())
+        .unwrap_or_default();
+    let backtrace = std::backtrace::Backtrace::force_capture();
+    let dir = std::path::PathBuf::from("C:\\diag203-mio");
+    let _ = std::fs::create_dir_all(&dir);
+    let path = dir.join(format!("hits-{}.log", std::process::id()));
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(
+            file,
+            "=== DIAG203-HIT seq={seq} kind={kind} {detail} pid={} unix_ms={now} thread={:?} exe={exe}\n{backtrace}\n=== END",
+            std::process::id(),
+            thread.name(),
+        );
+    }
+}
